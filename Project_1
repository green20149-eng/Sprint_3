import datetime

class OnlineSalesRegisterCollector:

    def __init__(self):
        self.__name_items = []
        self.__number_items = 0
        self.__item_price = {'чипсы': 50, 'кола': 100, 'печенье': 45, 'молоко': 55, 'кефир': 70}
        self.__tax_rate = {'чипсы': 20, 'кола': 20, 'печенье': 20, 'молоко': 10, 'кефир': 10}

#1 Геттеры 
    @property
    def get_name_items(self):
        return self.__name_items
    
    @property
    def get_number_items(self):
        return self.__number_items

#2 Добавление товаров в чек 

    def add_item_to_cheque(self, name):
        if len(name) == 0 or len(name) > 40:
            raise ValueError('Нельзя добавить товар, если в его названии нет символов или их больше 40')

        # Проверка наличия товара в справочнике цен
        if self.name not in self.__item_price:
            raise NameError('Позиция отсутствует в товарном справочнике')
        # Добавление товара в список и увеличение счётчика
            self.__name_items.append(name)
            self.__number_items += 1

#3 Удаление товара из чека

    def delete_item_from_check(self, name):
        if name not in self.__name_items:
            raise NameError('Позиция отсутствует в чеке')
        self.__name_items.remove(name)
        self.__number_items -= 1

#4 Общая стоимость товаров 
    def check_amount(self):
        total = []
        for name in self.__name_items:
            if name in self.__item_price:
                total.append(self.__item_price[name])
            else:
                raise NameError(f'Товар "{name}" отсутствует в товарном справочнике')
    
        full_amount = sum(total)
    
        if self.__number_items > 10:
            discounted_amount = full_amount * 0.9  # скидка 10%
            return discounted_amount
        else:
            return full_amount
        
#5 Вычисление НДС для товаров со ставкой 20%
    def twenty_percent_tax_calculation(self):
        twenty_percent_tax = []  # Список товаров с НДС 20 %
        total = []  # Список цен товаров с НДС 20 %

    # ЗПозиции с НДС 20 %
        for name in self.__name_items:
            if name in self.__tax_rate and self.__tax_rate[name] == 20:
                twenty_percent_tax.append(name)
            if name in self.__item_price:
                total.append(self.__item_price[name])
            else:
                raise NameError(f'Товар "{name}" отсутствует в товарном справочнике')

    # Стоимость товаров с НДС 20 % до учёта скидки
            full_amount_20_tax = sum(total)
    # Скидка 10 %
            if self.__number_items > 10:
                discounted_amount = full_amount_20_tax * 0,9  
        # НДС от суммы со скидкой: НДС = стоимость со скидкой × 0,2
                vat_amount = discounted_amount * 0,2
            else:
                vat_amount = full_amount_20_tax * 0,2
            return vat_amount
        
#6 Вычисление НДС для товаров со ставкой 10%
    def ten_percent_tax_calculation(self):
        ten_percent_tax = []  # Список товаров с НДС 10 %
        total = []  # Список цен товаров с НДС 10 %
    # Заполнение списков товарами
        for name in self.__name_items:
            if name in self.__tax_rate and self.__tax_rate[name] == 10:
                ten_percent_tax.append(name)
            if name in self.__item_price:
                total.append(self.__item_price[name])
            else:
                raise NameError(f'Товар "{name}" отсутствует в товарном справочнике')

    # Общая стоимость без скидки
            full_amount_10_tax = sum(self, total)
    # Применение скидки если более 10 товаров
            if self.__number_items > 10:
                discounted_amount = full_amount_10_tax * 0,9  # скидка 10 %
        # НДС от суммы со скидкой: НДС = стоимость со скидкой × 0,1
                vat_amount = discounted_amount * 0,1
            else:
        # НДС без скидки: НДС = исходная стоимость × 0,1
                vat_amount = full_amount_10_tax * 0,1
                return vat_amount
            
#7 Расчёт общей суммы налога 
    def total_tax(self):
        tax_20 = self.twenty_percent_tax_calculation()
        tax_10 = self.ten_percent_tax_calculation()
        total_tax = tax_20 + tax_10
        return total_tax
    
#8 Возврат номера телефона покупателя
    @staticmethod
    def get_telephone_number(telephone_number):
    # Проверяем, является ли аргумент целым числом
        if not isinstance(telephone_number, int):
            raise ValueError('Необходимо ввести цифры')
    # Преобразование строки в чсило
        telephone_str = str(telephone_number)
    # Проверяем длину строки
        if len(telephone_str) != 10:
            raise ValueError('Необходимо ввести 10 цифр после "+7"')
    # Возвращаем полный номер телефона в формате +7XXXXXXXXXX
        return f'+7{telephone_str}'
